# Copia este archivo a ".env" y rellena los valores. NUNCA subas ".env" a git.

# Contraseña para entrar a la web (usa una larga)
APP_PASSWORD=cambia-esta-contrasena

# Clave para firmar la cookie de sesión. Genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=pon-aqui-una-cadena-aleatoria-larga

# Clave gratuita de Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=tu-clave-de-gemini

# Modelo de Gemini para analizar la transcripción
GEMINI_MODEL=gemini-3.5-flash

# Modelo local de Whisper para videos sin subtítulos (tiny = rápido, base = más preciso)
WHISPER_MODEL=base

# Carpeta donde se guardan descargas y clips
DATA_DIR=data

# Límite de duración del video a procesar (minutos)
MAX_VIDEO_MINUTES=180

# Duración de cada clip (segundos)
CLIP_MIN_SECONDS=20
CLIP_MAX_SECONDS=60

# Idiomas de subtítulos a intentar, en orden (coma-separados)
SUBTITLE_LANGS=es,en

# Pon true si sirves la web por HTTPS (recomendado en producción)
COOKIE_SECURE=false

# SameSite de la cookie: lax (por defecto) o none (necesario si se muestra dentro de un iframe, p. ej. Hugging Face; requiere COOKIE_SECURE=true)
COOKIE_SAMESITE=lax

# Opcional: archivo de cookies de yt-dlp (para videos que piden login)
# YTDLP_COOKIES_FILE=cookies.txt
